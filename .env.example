# Service
PORT=8402
PUBLIC_BASE_URL=http://localhost:8402
APP_ENV=development

# Venice inference (server-side only)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_TEXT_MODEL=venice-uncensored-1-2
VENICE_IMAGE_MODEL=venice-sd35
VENICE_TTS_MODEL=tts-kokoro
VENICE_ASR_MODEL=openai/whisper-large-v3
VENICE_TIMEOUT_MS=45000
VENICE_READINESS_CACHE_MS=15000
# Configure provider-capacity thresholds only in the private deployment environment.

# x402: off | development (Base Sepolia) | production (Base mainnet)
PAYMENTS_MODE=off
# Operational kill switch. Leave false unless a reviewed deployment is ready.
STOREFRONT_ENABLED=false
X402_PRICE_USD=0.02
X402_CLASSIFY_PRICE_USD=0.01
X402_SUMMARIZE_PRICE_USD=0.02
X402_TTS_PRICE_USD=0.01
X402_IMAGE_PRICE_USD=0.02
X402_TRANSCRIBE_PRICE_USD=0.015
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Durable paid-delivery protection: off | enforced. Mainnet requires enforced.
DELIVERY_CREDITS_MODE=off
# Generate independently with at least 32 random bytes; never reuse another key.
DELIVERY_CREDIT_HMAC_SECRET=
DELIVERY_CREDIT_TTL_SECONDS=86400
DELIVERY_CREDIT_LEASE_SECONDS=180
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Atomic global provider-capacity reservation: off | enforced. Mainnet requires enforced.
COMPUTE_BUDGET_MODE=off
# Configure the reviewed software ceiling only in the private deployment environment.
# Durable lifetime counters only: off | enabled. Mainnet requires enabled.
# Reuses Upstash and never stores content, caller identifiers, or timestamps.
AGGREGATE_METRICS_MODE=off
# Public Base address that receives x402 payments. Never put a private key here.
TREASURY_ADDRESS=
