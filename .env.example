# Service
PORT=8402
PUBLIC_BASE_URL=http://localhost:8402
APP_ENV=development

# Venice inference (server-side only)
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_TEXT_MODEL=venice-uncensored-1-2
VENICE_IMAGE_MODEL=venice-sd35
VENICE_TTS_MODEL=tts-kokoro
VENICE_ASR_MODEL=openai/whisper-large-v3
VENICE_TIMEOUT_MS=45000
VENICE_READINESS_CACHE_MS=15000
# Must match the native EPOCH limit configured on this Venice API key.
VENICE_DIEM_EPOCH_CAP=1.69

# x402: off | development (Base Sepolia) | production (Base mainnet)
PAYMENTS_MODE=off
X402_PRICE_USD=0.02
X402_CLASSIFY_PRICE_USD=0.005
X402_SUMMARIZE_PRICE_USD=0.005
X402_TTS_PRICE_USD=0.01
X402_IMAGE_PRICE_USD=0.02
X402_TRANSCRIBE_PRICE_USD=0.015
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Durable paid-delivery protection: off | enforced. Mainnet requires enforced.
DELIVERY_CREDITS_MODE=off
# Generate independently with at least 32 random bytes; never reuse another key.
DELIVERY_CREDIT_HMAC_SECRET=
DELIVERY_CREDIT_TTL_SECONDS=86400
DELIVERY_CREDIT_LEASE_SECONDS=180
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Payments settle directly to this EVM address. In production it should be the
# same dedicated address used by the treasury runner below.
TREASURY_ADDRESS=
TREASURY_KEYCHAIN_SERVICE=com.diem-agent-workers.treasury
TREASURY_KEYCHAIN_ACCOUNT=
TREASURY_KEYCHAIN_BACKEND=security-cli

# Reinvestment treasury: disabled | quote | live
# quote reads balances and obtains an indicative USDC->DIEM price but never signs.
TREASURY_MODE=disabled
BASE_RPC_URL=https://mainnet.base.org
ZEROX_API_KEY=
TREASURY_PRIVATE_KEY=
TREASURY_MIN_SWAP_USDC=5
TREASURY_MAX_SWAP_USDC=25
TREASURY_USDC_HOLDBACK=0
TREASURY_MAX_SLIPPAGE_BPS=100
TREASURY_MIN_ETH_RESERVE=0.0005
TREASURY_MAX_GAS=500000
TREASURY_AUDIT_PATH=data/treasury-audit.jsonl
TREASURY_LOCK_PATH=data/treasury.lock
TREASURY_STATE_PATH=data/treasury-state.json

# Required verbatim before any mainnet transaction can be signed.
TREASURY_LIVE_ACK=
